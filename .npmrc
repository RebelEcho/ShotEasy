public-hoist-src-pattern = ""
# Override zod and zod-to-json-schema versions for compatibility
# zod-to-json-schema@3.25.2 needs zod@^3.25.28, but @astrojs/sitemap@3.5.0 needs zod@^3.24.4
# Solution: pin zod@3.24.4 and use compatible zod-to-json-schema@3.24.3
overrides.zod = 3.24.4
overrides.zod-to-json-schema = 3.24.3
